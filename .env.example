# --- LLM (via OpenRouter, OpenAI-compatible API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_MODEL=google/gemini-2.5-flash


# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prometheus
LANGSMITH_TRACING=true

# --- Vector store (pick one backend, see docs/architecture.md) ---
VECTOR_DB_BACKEND=chroma          # chroma | qdrant
CHROMA_PERSIST_DIR=./chroma_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Relational store (reports + reasoning chains) ---
DATABASE_URL=sqlite+aiosqlite:///./findings.db   # swap for postgresql://... in prod

# --- Application database (projects/documents/conversations workspace) ---
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Document storage (local filesystem for now, see new-plan.md section 33) ---
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=50

# --- Celery + Redis (background document processing) ---
REDIS_URL=redis://localhost:6379/0

# --- Web access (Phase 11) -- provider is DuckDuckGo (no key), see plan.md ---
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2097152
WEB_CRAWL_MAX_PAGES=10
WEB_CRAWL_MAX_DEPTH=2

# --- External paper sources ---
SEMANTIC_SCHOLAR_API_KEY=          # optional, raises rate limit
OPENALEX_MAILTO=you@example.com    # polite pool, gets you faster responses

# --- MCP server ---
MCP_SERVER_PORT=8765
