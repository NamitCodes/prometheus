# --- LLM (via OpenRouter, OpenAI-compatible API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prometheus
LANGSMITH_TRACING=true

# --- Vector store (pick one backend, see docs/architecture.md) ---
VECTOR_DB_BACKEND=chroma          # chroma | qdrant
CHROMA_PERSIST_DIR=./chroma_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Relational store (reports + reasoning chains) ---
DATABASE_URL=sqlite:///./findings.db   # swap for postgresql://... in prod

# --- External paper sources ---
SEMANTIC_SCHOLAR_API_KEY=          # optional, raises rate limit
OPENALEX_MAILTO=you@example.com    # polite pool, gets you faster responses

# --- MCP server ---
MCP_SERVER_PORT=8765
